# Supabase project credentials
# Get these from: https://app.supabase.com → Project → Settings → API

```dotenv
# Example environment variables for local and Vercel deployments

# --- Staging (used locally and on Vercel Preview builds) ---
VITE_SUPABASE_URL_STAGING=https://your-staging-project.supabase.co
VITE_SUPABASE_ANON_KEY_STAGING=staging-anon-key

# --- Production (used only on Vercel Production builds) ---
VITE_SUPABASE_URL_PROD=https://your-production-project.supabase.co
VITE_SUPABASE_ANON_KEY_PROD=production-anon-key

# --- Optional backward compatibility (will be used if specific staging/prod vars are missing) ---
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Vite does not expose VERCEL_ENV automatically to client code. To ensure the app
# selects production only on live (Vercel Production), set this env var in Vercel
# per-environment. Example values: "production", "preview".
VITE_VERCEL_ENV=preview

```
